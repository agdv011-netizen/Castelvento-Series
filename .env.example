# Environment variables for Castelvento Series

# Database
DB_USER=castelvento
DB_PASSWORD=castelvento_dev_password
DB_NAME=castelvento
DB_PORT=5432
DB_HOST=localhost

# Redis
REDIS_PORT=6379
REDIS_HOST=localhost

# Server
SERVER_PORT=3000
SERVER_URL=http://localhost:3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Stripe (for monetization)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Steam API (for future integration)
STEAM_API_KEY=your_steam_api_key

# Google Play Billing (for Android)
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=path/to/service-account.json

# Apple App Store (for iOS)
APPLE_APP_STORE_SHARED_SECRET=your_apple_shared_secret

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
